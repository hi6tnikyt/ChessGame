@model Chess.Models.Game

@{
    ViewData["Title"] = "Start New Game";
}

<h1>Start New Game</h1>

<h4>Game Setup</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label class="control-label">White Player</label>
                <select name="whitePlayerId" class="form-control" asp-items="ViewBag.WhitePlayerId">
                    <option value="">-- Select Player --</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <label class="control-label">Black Player</label>
                <select name="blackPlayerId" class="form-control" asp-items="ViewBag.BlackPlayerId">
                    <option value="">-- Select Player --</option>
                </select>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Start Game" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}