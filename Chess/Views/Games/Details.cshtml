@model Chess.Models.Game

@{
    ViewData["Title"] = "Game Details";
}

<h1>Game Room</h1>

<div class="row">
    <div class="col-md-4">
        <h4>Game Info</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">White</dt>
            <dd class="col-sm-8">@Model.WhitePlayer.Username (ID: @Model.WhitePlayerId)</dd>

            <dt class="col-sm-4">Black</dt>
            <dd class="col-sm-8">@Model.BlackPlayer.Username (ID: @Model.BlackPlayerId)</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8"><span class="badge bg-primary">@Model.Status</span></dd>

            <dt class="col-sm-4">Turn</dt>
            <dd class="col-sm-8"><strong>@Model.CurrentTurn</strong></dd>
        </dl>

        @if (Model.Status == "Active")
        {
            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">Make a Move</h5>
                    <form asp-action="Move" method="post">
                        <input type="hidden" name="gameId" value="@Model.Id" />
                        <div class="row">
                            <div class="col">
                                <label>From (x,y)</label>
                                <input type="number" name="x1" class="form-control" placeholder="x" min="0" max="7" required />
                                <input type="number" name="y1" class="form-control mt-1" placeholder="y" min="0" max="7" required />
                            </div>
                            <div class="col">
                                <label>To (x,y)</label>
                                <input type="number" name="x2" class="form-control" placeholder="x" min="0" max="7" required />
                                <input type="number" name="y2" class="form-control mt-1" placeholder="y" min="0" max="7" required />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label>Player ID (Current)</label>
                            <input type="number" name="playerId" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100 mt-3">Submit Move</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        <h4>Board Position (FEN)</h4>
        <div class="alert alert-secondary font-monospace">
            @Model.BoardFen
        </div>

        <h4 class="mt-4">Move History</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Move</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var move in Model.Moves.OrderBy(m => m.MoveNumber))
                {
                    <tr>
                        <td>@move.MoveNumber</td>
                        <td>@move.MoveText</td>
                        <td>@move.MoveTime.ToShortTimeString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>